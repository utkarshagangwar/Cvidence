# Cvidence environment variables. Copy to .env.local for local dev and set the
# same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). SERVER ONLY. Used for the credit ledger.
SUPABASE_SECRET_KEY=sb_secret_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI providers ---------------------------------------------------------------
# Order to try providers in; later ones are fallbacks.
AI_PROVIDER_ORDER=gemini,openrouter
# Pin exact model ids (no "-latest" aliases) so every result records what wrote it.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=
GEMINI_MODEL_STRONG=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_STRONG=

# --- Quotas ---------------------------------------------------------------------
AI_DAILY_CREDITS=25
# Platform-wide token cap per IST day; AI pauses when it's reached.
AI_DAILY_TOKEN_CAP=2000000


# --- Job ingestion ---------------------------------------------------------------
# Shared secret pg_cron sends to /api/worker/ingest (32+ random characters).
WORKER_SECRET=
# Paid job boards add their key names here, matching the adapter's requiredEnv.

# --- Email (Resend): morning digest and the daily usage report ---------------
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Cvidence <digest@yourdomain.com>
RESEND_FROM=
# Where the daily usage report goes (you, the operator).
OPERATOR_EMAIL=

# --- Launch ------------------------------------------------------------------
# Cloudflare Turnstile site key (public). The secret goes into Supabase Auth, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Shown on /privacy and /terms.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
